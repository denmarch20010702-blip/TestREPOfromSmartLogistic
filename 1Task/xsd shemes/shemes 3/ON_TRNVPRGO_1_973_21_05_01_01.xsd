																					</sch:assert>
																				</sch:rule>
																			</sch:pattern>
																		</xs:appinfo>
																		<!---*************************************************************************************************************************************************************-->
																		<!---*************************************************************************************************************************************************************-->
																		<xs:appinfo>
																			<sch:pattern name="Наличие элемента КолПломб в зависимости от наличия элемента КолПломб">
																				<sch:rule context="СвКонтейн">
																					<sch:assert test="usch:iif( 
						count(@КолПломб)!=0 ,
						count(НомПломб)!=0  , 
						( count(НомПломб)!=0 or count(НомПломб)=0 ) 

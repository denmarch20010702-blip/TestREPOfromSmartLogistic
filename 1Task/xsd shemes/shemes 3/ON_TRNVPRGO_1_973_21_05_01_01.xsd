												<usch:error code="0400400007" path="@ИныеСвед" value-of-select="count(@ИныеСвед)"> Не выполнено условие присутствия (отсутствия) элемента @ИныеСвед при наличии элемента ФИО в количестве, равном "<usch:value-of select="count(ФИО)"/>". </usch:error>
											</sch:assert>
										</sch:rule>
									</sch:pattern>
								</xs:appinfo>
								<!---*************************************************************************************************************************************************************-->

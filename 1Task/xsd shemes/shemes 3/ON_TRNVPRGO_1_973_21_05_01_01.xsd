																		<xs:fractionDigits value="4"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ВесГрузКонтр" use="optional">
																<xs:annotation>
																	<xs:documentation>Вес груза, брутто с контейнером (кг)</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:decimal">
																		<xs:totalDigits value="18"/>
																		<xs:fractionDigits value="6"/>

																						<usch:error code="0400400007" path="НомПломб" value-of-select="count(НомПломб)"> Не выполнено условие присутствия (отсутствия) элемента НомПломб при наличии элемента  КолПломб в количестве, равном "<usch:value-of select="count(@КолПломб)"/>". </usch:error>
																					</sch:assert>
																				</sch:rule>
																			</sch:pattern>
																		</xs:appinfo>

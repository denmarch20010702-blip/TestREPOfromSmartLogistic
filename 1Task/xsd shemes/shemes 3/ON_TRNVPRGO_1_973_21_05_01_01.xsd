																		<xs:fractionDigits value="6"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ОбъемФакт" use="optional">
																<xs:annotation>
																	<xs:documentation>Фактический объем груза, в кубических метрах</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:decimal">
																		<xs:totalDigits value="18"/>
																		<xs:fractionDigits value="6"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ВесГруз" use="required">

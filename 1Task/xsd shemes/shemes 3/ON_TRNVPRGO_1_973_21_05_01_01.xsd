																		<!---*************************************************************************************************************************************************************-->
																		<xs:appinfo>
																			<sch:pattern name="Наличие элемента КолПломб в зависимости от наличия элемента НомПломб">
																				<sch:rule context="СвКонтейн">
																					<sch:assert test="usch:iif( 
						count(НомПломб)!=0 ,
						count(@КолПломб)!=0  , 
						( count(@КолПломб)!=0 or count(@КолПломб)=0 ) 

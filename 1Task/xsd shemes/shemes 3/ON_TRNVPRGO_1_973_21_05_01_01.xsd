																		<xs:enumeration value="665"/>
																		<xs:enumeration value="671"/>
																		<xs:enumeration value="672"/>
																		<xs:enumeration value="673"/>
																		<xs:enumeration value="674"/>
																		<xs:enumeration value="676"/>
																		<xs:enumeration value="677"/>
																		<xs:enumeration value="680"/>

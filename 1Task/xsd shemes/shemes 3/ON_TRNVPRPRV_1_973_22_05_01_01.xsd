														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="10"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="ТарифОтм">
											<xs:annotation>
												<xs:documentation>Тарифные расстояния и отметки</xs:documentation>
											</xs:annotation>

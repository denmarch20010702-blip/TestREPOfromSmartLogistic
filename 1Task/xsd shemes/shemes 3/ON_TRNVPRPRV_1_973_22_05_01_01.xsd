															<xs:totalDigits value="2"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ЗамДатВрПриб" type="ДатаВремяВЗТип" use="optional">
													<xs:annotation>
														<xs:documentation>Оговорки и замечания в отношении фактических даты и времени прибытия</xs:documentation>
													</xs:annotation>
												</xs:attribute>
												<xs:attribute name="ЗамДатВрУбыт" type="ДатаВремяВЗТип" use="optional">
													<xs:annotation>
														<xs:documentation>Оговорки и замечания в отношении фактических даты и времени убытия</xs:documentation>
													</xs:annotation>
												</xs:attribute>
												<xs:attribute name="ЗамДатВрПосПрием" type="ДатаВремяВЗТип" use="optional">
													<xs:annotation>
														<xs:documentation>Оговорки и замечания в отношении фактических даты и времени постановки на погрузку</xs:documentation>
													</xs:annotation>
												</xs:attribute>
												<xs:attribute name="ЗамМасс" use="optional">
													<xs:annotation>
														<xs:documentation>Оговорки и замечания в отношении массы груза</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ЗамКолМест" use="optional">
													<xs:annotation>
														<xs:documentation>Оговорки и замечания в отношении количества грузовых мест</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ЗамПогрРаб" use="optional">

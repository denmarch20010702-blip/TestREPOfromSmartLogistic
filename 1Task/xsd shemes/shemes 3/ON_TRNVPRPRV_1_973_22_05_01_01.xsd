												<xs:appinfo>
													<sch:pattern name="Наличие элемента ИнОбстОтмет в зависимости от значения элемента ОбстОтмет">
														<sch:rule context="ОтметПрвПрием">
															<sch:assert test="usch:iif( 
						@ОбстОтмет=4  ,
						count(@ИнОбстОтмет)!=0  , 
						count(@ИнОбстОтмет)=0 or count(@ИнОбстОтмет)!=0
						)">
																<usch:error code="0400400007" path="@ИнОбстОтмет" value-of-select="count(@ИнОбстОтмет)"> Не выполнено условие присутствия (отсутствия) элемента ИнОбстОтмет при при значении элемента ОбстОтмет, равном "<usch:value-of select="@ОбстОтмет"/>". </usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>
												<!---*************************************************************************************************************************************************************-->
												<xs:documentation>Сведения об отметках перевозчика при приеме груза</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="СвАкт" type="РеквДокТип" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Сведения о коммерческих и иных актах, в том числе о погрузке груза</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Информационное поле</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="ДатВрОтмет" type="ДатаВремяВЗТип" use="required">
													<xs:annotation>
														<xs:documentation>Дата и время отметки</xs:documentation>
													</xs:annotation>
												</xs:attribute>
												<xs:attribute name="ОбстОтмет" use="required">
													<xs:annotation>
														<xs:documentation>Описание обстоятельств, послуживших основанием для отметки</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:length value="1"/>
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
															<xs:enumeration value="4"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ИнОбстОтмет" use="optional">
													<xs:annotation>
														<xs:documentation>Иное описание обстоятельств, послужившее основанием для отметки</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="255"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ОтмАктВзв" use="optional">
													<xs:annotation>
														<xs:documentation>Отметки в отношении акта взвешивания</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="СвСудно">

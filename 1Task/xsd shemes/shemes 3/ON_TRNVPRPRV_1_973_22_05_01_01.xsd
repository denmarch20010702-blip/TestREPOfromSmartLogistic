												<xs:appinfo>
													<sch:pattern name="Наличие элемента ИнЗамСостГруз в зависимости от значения элемента ЗамСостГруз">
														<sch:rule context="ЗамПрвПрием">
															<sch:assert test="usch:iif( 
						count(ЗамСостГруз)!=0 and ЗамСостГруз=12  ,
						count(ИнЗамСостГруз)!=0  , 
						count(ИнЗамСостГруз)=0 or count(ИнЗамСостГруз)!=0
						)">
																<usch:error code="0400400007" path="ИнЗамСостГруз" value-of-select="count(ИнЗамСостГруз)"> Не выполнено условие присутствия (отсутствия) элемента ИнЗамСостГруз при при значении элемента ЗамСостГруз, равном "<usch:value-of select="ЗамСостГруз"/>". </usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>

												<xs:sequence>
													<xs:element name="МагистрОтм" type="ОтметкаТип">
														<xs:annotation>
															<xs:documentation>Магистральные пути</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="РекаОтм" type="ОтметкаТип">
														<xs:annotation>
															<xs:documentation>Малые реки</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="Всего" type="ОтметкаТип">
														<xs:annotation>
															<xs:documentation>Всего</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Тариф" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Тарифная ставка</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:attribute name="ОтмАктВзв" use="required">
													<xs:annotation>
														<xs:documentation>Тарифная ставка</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="Всего" use="required">
													<xs:annotation>
														<xs:documentation>Всего</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="ПлатаОтпр" type="ПлатаСборТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Платы и сборы (при отправлении)</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ПлатаВыд" type="ПлатаСборТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Платы и сборы (при выдаче)</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Информационное поле</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="УИД_ТрН" use="required">
										<xs:annotation>
											<xs:documentation>Уникальный идентификатор документа (УИД) электронной транспортной накладной</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="36"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="СодОпер" use="required">
										<xs:annotation>
											<xs:documentation>Содержание операции</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="255"/>
												<xs:enumeration value="груз принят к перевозке капитаном, уполномоченным перевозчиком на перевозку груза, от лица, осуществившего погрузку груза на судно"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="ПодпИнфПрв" type="ПодписантТип" maxOccurs="unbounded">
								<xs:annotation>
									<!---*************************************************************************************************************************************************************-->
									<xs:appinfo>
										<sch:pattern name="Наличие элемента СвДоверЭл в зависимости от значения элемента СпосПодтПолном">
											<sch:rule context="ПодпИнфПрв">
												<sch:assert test="usch:iif( 
						@СпосПодтПолном=3  ,
						count(СвДоверЭл)!=0  , 
						count(СвДоверЭл)=0 
						)">
													<usch:error code="0400400007" path="СвДоверЭл" value-of-select="count(СвДоверЭл)"> Не выполнено условие присутствия (отсутствия) элемента СвДоверЭл при при значении элемента СпосПодтПолном, равном "<usch:value-of select="@СпосПодтПолном"/>". </usch:error>
												</sch:assert>
											</sch:rule>
										</sch:pattern>
									</xs:appinfo>
									<!---*************************************************************************************************************************************************************-->
									<!---*************************************************************************************************************************************************************-->
									<xs:appinfo>
										<sch:pattern name="Наличие элемента СвДоверБум в зависимости от значения элемента СпосПодтПолном">
											<sch:rule context="ПодпИнфПрв">
												<sch:assert test="usch:iif( 
						@СпосПодтПолном=5  ,
						count(СвДоверБум)!=0  , 
						count(СвДоверБум)=0 
						)">
													<usch:error code="0400400007" path="СвДоверБум" value-of-select="count(СвДоверБум)"> Не выполнено условие присутствия (отсутствия) элемента СвДоверБум при при значении элемента СпосПодтПолном, равном "<usch:value-of select="@СпосПодтПолном"/>". </usch:error>
												</sch:assert>
											</sch:rule>
										</sch:pattern>
									</xs:appinfo>
									<!---*************************************************************************************************************************************************************-->
									<xs:documentation>Сведения о лице, подписывающем файл обмена информации перевозчика</xs:documentation>
								</xs:annotation>
							</xs:element>
